{
  "name": "webtangl",
  "private": true,
  "version": "3.8.0",
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:restart": "playwright test --config playwright.restart.config.ts",
    "build:e2e": "VITE_DEFAULT_API_URL=http://127.0.0.1:4173/api/v2 VITE_DEFAULT_USER_SECRET= VITE_DEFAULT_WORLD= VITE_MOCK_RESPONSES=false VITE_DEBUG=false VITE_VERBOSE=false yarn build",
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "type-check": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write src/",
    "generate-api": "openapi-typescript ../server/openapi.json -o src/types/api.d.ts"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "axios": "^1.7.7",
    "pinia": "^2.2.6",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5",
    "vuetify": "^3.7.4"
  },
  "devDependencies": {
    "@pinia/testing": "^0.1.6",
    "@playwright/test": "1.64.1",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitest/coverage-v8": "^2.1.4",
    "@vitest/ui": "^2.1.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.29.0",
    "happy-dom": "^15.7.4",
    "msw": "^2.11.6",
    "openapi-typescript": "^7.4.3",
    "prettier": "^3.3.3",
    "sass-embedded": "^1.93.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-vuetify": "^2.0.4",
    "vitest": "^2.1.4",
    "vue-tsc": "^2.1.6"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
