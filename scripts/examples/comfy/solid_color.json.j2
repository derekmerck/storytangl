{
  "1": {
    "class_type": "EmptyImage",
    "inputs": {
      "width": 64,
      "height": 64,
      "batch_size": 1,
      "color": {{ color | default(3368652) }}
    }
  },
  "2": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["1", 0],
      "filename_prefix": {{ prefix | default("storytangl/solid-color") | tojson }}
    }
  }
}
