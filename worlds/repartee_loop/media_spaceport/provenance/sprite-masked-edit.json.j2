{
  "load_source":   {"class_type": "LoadImage", "inputs": {"image": {{ images.source | tojson }}}},
  "load_mask":     {"class_type": "LoadImageMask", "inputs": {"image": {{ images.mask | tojson }}, "channel": "red"}},
  "grow":          {"class_type": "GrowMask", "inputs": {"mask": ["load_mask", 0], "expand": {{ grow }}, "tapered_corners": true}},
  "unet":          {"class_type": "UNETLoader", "inputs": {"unet_name": "flux-2-klein-9b-kv-fp8.safetensors", "weight_dtype": "default"}},
  "clip":          {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen_3_8b_fp8mixed.safetensors", "type": "flux2", "device": "default"}},
  "vae":           {"class_type": "VAELoader", "inputs": {"vae_name": "flux2-vae.safetensors"}},
  "positive":      {"class_type": "CLIPTextEncode", "inputs": {"clip": ["clip", 0], "text": {{ prompt | tojson }}}},
  "encode_source": {"class_type": "VAEEncode", "inputs": {"pixels": ["load_source", 0], "vae": ["vae", 0]}},
  "identity":      {"class_type": "ReferenceLatent", "inputs": {"conditioning": ["positive", 0], "latent": ["encode_source", 0]}},
  "noise_mask":    {"class_type": "SetLatentNoiseMask", "inputs": {"samples": ["encode_source", 0], "mask": ["grow", 0]}},
  "sigmas":        {"class_type": "Flux2Scheduler", "inputs": {"steps": {{ steps }}, "width": 1024, "height": 1024}},
  "split_sigmas":  {"class_type": "SplitSigmasDenoise", "inputs": {"sigmas": ["sigmas", 0], "denoise": {{ denoise }}}},
  "noise":         {"class_type": "RandomNoise", "inputs": {"noise_seed": {{ seed }}}},
  "guider":        {"class_type": "BasicGuider", "inputs": {"model": ["unet", 0], "conditioning": ["identity", 0]}},
  "sampler":       {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler"}},
  "sample":        {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["noise", 0], "guider": ["guider", 0], "sampler": ["sampler", 0], "sigmas": ["split_sigmas", 1], "latent_image": ["noise_mask", 0]}},
  "decode":        {"class_type": "VAEDecode", "inputs": {"samples": ["sample", 0], "vae": ["vae", 0]}},
  "save":          {"class_type": "SaveImage", "inputs": {"images": ["decode", 0], "filename_prefix": {{ ("sprite_sheets/edit/" ~ label) | tojson }}}},
  "mask_image":    {"class_type": "MaskToImage", "inputs": {"mask": ["grow", 0]}},
  "save_mask":     {"class_type": "SaveImage", "inputs": {"images": ["mask_image", 0], "filename_prefix": {{ ("sprite_sheets/edit/" ~ label ~ "-mask") | tojson }}}},
  "load_removal":  {"class_type": "LoadBackgroundRemovalModel", "inputs": {"bg_removal_name": "birefnet.safetensors"}},
  "remove_bg":     {"class_type": "RemoveBackground", "inputs": {"bg_removal_model": ["load_removal", 0], "image": ["decode", 0]}},
  "invert":        {"class_type": "InvertMask", "inputs": {"mask": ["remove_bg", 0]}},
  "join_alpha":    {"class_type": "JoinImageWithAlpha", "inputs": {"image": ["decode", 0], "alpha": ["invert", 0]}},
  "save_rgba":     {"class_type": "SaveImage", "inputs": {"images": ["join_alpha", 0], "filename_prefix": {{ ("sprite_sheets/edit/" ~ label ~ "-rgba") | tojson }}}}
}