{
  "1":  {"class_type": "LoadImage", "inputs": {"image": {{ images.source | tojson }}}},
  "2":  {"class_type": "ImageScaleToTotalPixels",
         "inputs": {"upscale_method": "lanczos", "megapixels": 1, "resolution_steps": 1, "image": ["1", 0]}},
  "4":  {"class_type": "UNETLoader",
         "inputs": {"unet_name": "flux-2-klein-4b-fp8.safetensors", "weight_dtype": "default"}},
  "5":  {"class_type": "CLIPLoader",
         "inputs": {"clip_name": "qwen_3_4b.safetensors", "type": "flux2", "device": "default"}},
  "6":  {"class_type": "VAELoader", "inputs": {"vae_name": "flux2-vae.safetensors"}},
  "7":  {"class_type": "CLIPTextEncode", "inputs": {"clip": ["5", 0], "text": {{ prompt | tojson }}}},
  "8":  {"class_type": "ConditioningZeroOut", "inputs": {"conditioning": ["7", 0]}},
  "9":  {"class_type": "VAEEncode", "inputs": {"pixels": ["2", 0], "vae": ["6", 0]}},
  "10": {"class_type": "ReferenceLatent", "inputs": {"conditioning": ["7", 0], "latent": ["9", 0]}},
  "12": {"class_type": "EmptyFlux2LatentImage",
         "inputs": {"width": {{ width }}, "height": {{ height }}, "batch_size": 1}},
  "13": {"class_type": "Flux2Scheduler",
         "inputs": {"steps": {{ steps }}, "width": {{ width }}, "height": {{ height }}}},
  "14": {"class_type": "RandomNoise", "inputs": {"noise_seed": {{ seed }}}},
  "15": {"class_type": "CFGGuider",
         "inputs": {"cfg": {{ cfg }}, "model": ["4", 0], "positive": ["10", 0], "negative": ["8", 0]}},
  "16": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler"}},
  "17": {"class_type": "SamplerCustomAdvanced",
         "inputs": {"noise": ["14", 0], "guider": ["15", 0], "sampler": ["16", 0],
                    "sigmas": ["13", 0], "latent_image": ["12", 0]}},
  "18": {"class_type": "VAEDecode", "inputs": {"samples": ["17", 0], "vae": ["6", 0]}},
  "20": {"class_type": "SaveImage", "inputs": {"images": ["18", 0], "filename_prefix": {{ prefix | tojson }}}}
}
